# 机器人名字，会显示在日志中
WECHATY_NAME=PadLocalDemo

# Puppet 通道: padlocal | service
WECHATY_PUPPET_PROVIDER=padlocal

# padlocal 通道专用 Token
WECHATY_PUPPET_PADLOCAL_TOKEN=>>>>_YOUR_PADLOCAL_TOKEN_<<<<

# service 通道专用 Token 与服务地址（切到 service 时填写）
WECHATY_PUPPET_SERVICE_TOKEN=>>>>_YOUR_SERVICE_TOKEN_<<<<
WECHATY_PUPPET_SERVICE_ENDPOINT=

# 你自己的业务 API 基址（可选）
API_BASE_URL=

# ===== 新增能力配置 =====
# WebUI 管理面板端口
WEB_PORT=8765
# SQLite 数据库文件路径（记忆/用量/对话）
DB_PATH=bot-data/bot.db

# LLM/Agent 智能回复（OpenAI 兼容 API）
# 需同时配置 base 与 key 才启用；缺任一则回退为纯规则回复
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_SYSTEM_PROMPT=